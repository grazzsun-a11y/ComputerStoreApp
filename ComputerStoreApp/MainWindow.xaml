<Window x:Class="ComputerStoreApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border x:Name="TopPanel" DockPanel.Dock="Top" Background="#333" Padding="10" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="TxtUser" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Каталог" Width="100" Height="25" Margin="5,0" Click="BtnCatalog_Click"/>
                    <Button Content="Заказы" Width="100" Height="25" Margin="5,0" Click="BtnOrders_Click"/>
                    <Button Content="Выйти" Width="80" Height="25" Margin="5,0" Click="BtnLogout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>