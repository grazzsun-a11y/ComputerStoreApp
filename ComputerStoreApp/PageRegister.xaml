<Page x:Class="ComputerStoreApp.PageRegister"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="ФИО"/>
        <TextBox x:Name="TxtName" Height="25" Margin="0,5,0,10"/>
        <TextBlock Text="Email"/>
        <TextBox x:Name="TxtEmail" Height="25" Margin="0,5,0,10"/>
        <TextBlock Text="Телефон"/>
        <TextBox x:Name="TxtPhone" Height="25" Margin="0,5,0,10"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="TxtPass" Height="25" Margin="0,5,0,15"/>
        <Button Content="Зарегистрироваться" Height="30" Click="BtnSave_Click" Background="#27ae60" Foreground="White"/>
        <Button Content="Назад к входу" Height="30" Margin="0,5,0,0" Click="BtnBack_Click"/>
        <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Page>