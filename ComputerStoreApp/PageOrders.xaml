<Page x:Class="ComputerStoreApp.PageOrders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="GridOrders" AutoGenerateColumns="True" IsReadOnly="True"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Удалить" Width="100" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>