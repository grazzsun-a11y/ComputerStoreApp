<Page x:Class="ComputerStoreApp.PageCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="GridProducts" AutoGenerateColumns="True" IsReadOnly="True"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Кол-во:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtQty" Width="50" Margin="5,0,10,0" Text="1"/>
            <Button Content="Купить" Width="120" Click="BtnBuy_Click"/>
        </StackPanel>
    </Grid>
</Page>